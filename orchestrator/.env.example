# Caminhos dos repositórios gitops (locais ou clonados pelo GitHub Actions)
GITOPS_STAGING_PATH=/path/to/gitops-staging
GITOPS_PROD_PATH=/path/to/gitops-production

# Nota: NAMESPACE não é configurado aqui.
# O namespace é lido do campo 'namespace' no values.yaml base de cada serviço
# em gitops-staging/<service>/values.yaml
